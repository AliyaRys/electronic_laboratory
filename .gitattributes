# Normalize text to LF for consistent changes on Windows and Linux.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary project assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.docx binary
*.xlsx binary
*.woff binary
*.woff2 binary
