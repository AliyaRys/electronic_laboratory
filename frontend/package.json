{
  "name": "@vse-lab/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/typescript7/bin/tsc --noEmit && vite build",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build-storybook": "storybook build",
    "storybook": "storybook dev -p 6006",
    "test:e2e": "playwright test",
    "gen:api": "node scripts/gen-api.mjs"
  },
  "overrides": {},
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@tanstack/react-query": "5.106.1",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-router": "8.5.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^16.5.0",
    "jsdom": "31.0.0",
    "msw": "3.0.4",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "storybook": "10.6.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
