<?xml version="1.0" encoding="UTF-8"?>
<xs:schema targetNamespace="http://api.vetrf.ru/schema/cdm/application/ws-definitions" elementFormDefault="qualified" version="1.4" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:apl="http://api.vetrf.ru/schema/cdm/application" xmlns:bs="http://api.vetrf.ru/schema/cdm/base">

